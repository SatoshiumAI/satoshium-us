{
  "specification": "Satoshium Attestor Conformance Mechanics",
  "version": "0.1",
  "target_classes": [
    "object",
    "implementation",
    "process"
  ],
  "requirement_dispositions": [
    "satisfied",
    "not-satisfied",
    "not-applicable",
    "not-demonstrated"
  ],
  "aggregate_determinations": [
    "conformant",
    "nonconformant",
    "undetermined",
    "error"
  ],
  "validation_mapping": {
    "pass": "may-support-satisfied",
    "fail": "supports-not-satisfied",
    "not-applicable": "may-support-not-applicable",
    "not-tested": "not-demonstrated",
    "valid": "eligible-evidence-not-conformance",
    "invalid": "failed-validation-evidence",
    "incomplete": "insufficient-for-full-validation-backed-conformance",
    "error": "cannot-establish-conformance"
  },
  "initial_object_profile": {
    "requires_validation_aggregate": "valid",
    "requires_zero_mandatory_validation_failures": true,
    "requires_zero_mandatory_machine_not_tested": true,
    "requires_governed_review_for_applicable_review_rules": true,
    "requires_traceable_context_evidence": true,
    "requires_publication": false
  }
}